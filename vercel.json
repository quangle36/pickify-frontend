{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/album/:shareId",
      "destination": "https://p01--pickify-api--cx5nvhfxlc2k.code.run/album/:shareId"
    },
    {
      "source": "/api/:path*",
      "destination": "https://p01--pickify-api--cx5nvhfxlc2k.code.run/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
